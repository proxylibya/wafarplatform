# Development environment for the Wafar identity foundation.
# Copy to .env and fill the values. No secret value belongs in this file.

# PostgreSQL 16 through PgDog (development uses the pooler in front of the database).
DATABASE_URL=postgres://wafar:wafar@localhost:6432/wafar

# better-auth. The secret signs session cookies and the form stamp.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Trusted reverse-proxy addresses (comma-separated); only these may set X-Real-IP.
# Unset trusts no header and keys the peer's own address (contracts/auth-api.md §2.5).
TRUSTED_PROXIES=

# SMS transport: `fake` (development and CI) or `twilio`.
SMS_TRANSPORT=fake
# The fake transport's acceptance duration: whole milliseconds, 0..750, 0 by default.
SMS_FAKE_ACCEPT_MS=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Structured log level: debug | info | warn | error.
LOG_LEVEL=info

# Backup key-encryption key: a name only, never a value in a committed file.
BACKUP_KEY_ENCRYPTION_KEY=
