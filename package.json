{
  "name": "wafar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && node scripts/check/module-headers.mjs && node scripts/check/test-environments.mjs && node scripts/check/action-pins.mjs && node packages/config/scripts/check-dependency-budget.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project shared --project api --project ui --project web",
    "test:integration": "vitest run --project integration",
    "test:enumeration": "vitest run --config apps/api/test/integration/auth/vitest.enumeration.config.ts",
    "test:e2e": "pnpm --filter @wafar/web test:e2e",
    "test:a11y": "pnpm --filter @wafar/web test:a11y",
    "test:visual": "pnpm --filter @wafar/web test:visual",
    "test:inp": "pnpm --filter @wafar/web test:inp",
    "test:coverage": "vitest run --coverage",
    "test:tools": "node --test scripts/check/__tests__/coverage-gate.test.mjs",
    "db:up": "docker compose -f compose.dev.yml up -d postgres pgdog redis",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "pnpm --filter @wafar/db migrate",
    "db:reset": "pnpm --filter @wafar/db reset",
    "db:seed": "pnpm --filter @wafar/db seed",
    "load:auth": "node scripts/load/auth-smoke.mjs",
    "load:seed": "node scripts/fixtures/seed.mjs",
    "sbom": "node scripts/gen/sbom.mjs",
    "governance": "node governance-drift-check.mjs",
    "check:deps": "node packages/config/scripts/check-dependency-budget.mjs",
    "check:headers": "node scripts/check/module-headers.mjs",
    "check:emoji": "node scripts/gen/emoji-data.mjs --check"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.37.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@iconify-json/icon-park": "1.2.4",
    "@iconify-json/icon-park-outline": "1.2.4",
    "@lhci/cli": "^0.16.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^27.4.0",
    "nuxt": "4.6.4",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "^39.0.1",
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.2.0"
  }
}
