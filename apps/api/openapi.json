{
  "openapi": "3.1.0",
  "info": {
    "title": "Wafar Identity and Foundation API",
    "version": "1.0.0",
    "description": "The public authentication surface of R1. Generated from packages/shared/src/contracts and the route table."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "summary": "The render bootstrap",
        "tags": [
          "transport"
        ],
        "responses": {
          "200": {
            "description": "A CSRF token and a signed form stamp"
          },
          "default": {
            "description": "The error envelope of contracts/auth-api.md §3",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "retryable"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "field": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "empty",
                            "too_long",
                            "emoji"
                          ]
                        },
                        "retryAfterSeconds": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-up": {
      "post": {
        "summary": "Start an account-creation request",
        "tags": [
          "sign-up"
        ],
        "responses": {
          "202": {
            "description": "The pending request and the resume cookie"
          },
          "default": {
            "description": "The error envelope of contracts/auth-api.md §3",
