                        "field": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "empty",
                            "too_long",
                            "emoji"
                          ]
                        },
                        "retryAfterSeconds": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "shopName": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "website": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "formStamp": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "required": [
                  "fullName",
                  "phone",
                  "password",
                  "city"
                ]
              }
            }
          }
        }
      }
    },
